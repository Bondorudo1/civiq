# Copy to .env and adjust. Expo inlines EXPO_PUBLIC_* at bundle time.
#
# Emulator / web:      http://localhost:8000/api
# Physical device:     http://<your-machine-LAN-IP>:8000/api   (localhost is the phone itself)
#
# Never put secrets behind EXPO_PUBLIC_ — the value ships inside the app bundle.
EXPO_PUBLIC_API_URL=http://localhost:8000/api
